# Atlas Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# REQUIRED: Supabase Configuration
# ===========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# OPTIONAL: DocuSeal E-Signature Integration
# ===========================================
# Get your API key from DocuSeal dashboard
VITE_DOCUSEAL_URL=https://api.docuseal.co
VITE_DOCUSEAL_API_KEY=your-docuseal-api-key

# ===========================================
# OPTIONAL: Plaid Bank Integration
# ===========================================
# VITE_PLAID_CLIENT_ID=your-plaid-client-id
# VITE_PLAID_SECRET=your-plaid-secret

# ===========================================
# OPTIONAL: Microsoft 365 / Azure AD Integration
# ===========================================
# Required for SharePoint and Outlook integration
VITE_AZURE_CLIENT_ID=your-azure-client-id
VITE_AZURE_TENANT_ID=your-azure-tenant-id
VITE_AZURE_REDIRECT_URI=http://localhost:5173/auth/callback

# Microsoft Graph API (same as Azure AD for most cases)
VITE_MS_TENANT_ID=your-ms-tenant-id
VITE_MS_CLIENT_ID=your-ms-client-id
# Note: Client secret should be handled server-side only
# VITE_MS_CLIENT_SECRET=your-ms-client-secret

# SharePoint Configuration (optional)
# VITE_SHAREPOINT_SITE_ID=your-sharepoint-site-id
# VITE_SHAREPOINT_DRIVE_ID=your-sharepoint-drive-id

# ===========================================
# OPTIONAL: Demo Mode
# ===========================================
# Set to 'true' to run without Supabase connection
VITE_DEMO_MODE=false
